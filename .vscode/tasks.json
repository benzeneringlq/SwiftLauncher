{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Swiftlauncher (Release)",
            "type": "shell",
            "command": "./build.sh",
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "Build swiftlauncher-cli",
            "type": "shell",
            "command": "./build.sh",
            "args": [
                "cli"
            ],
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "Run Swiftlauncher (Release)",
            "type": "shell",
            "command": "./build.sh",
            "args": [
                "run"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Swiftlauncher to ~/Applications",
            "type": "shell",
            "command": "./build.sh",
            "args": [
                "install"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
