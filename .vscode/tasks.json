{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Swiftlauncher (Release)",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "Swiftlauncher.xcodeproj",
                "-scheme",
                "Swiftlauncher",
                "-configuration",
                "Release",
                "-derivedDataPath",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build swiftlauncher-cli",
            "type": "shell",
            "command": "/bin/sh",
            "args": [
                "-c",
                "mkdir -p build/Build/Products/Release && swiftc -O SwiftlauncherCLI.swift -o build/Build/Products/Release/swiftlauncher-cli"
            ],
            "problemMatcher": ["$swiftc"]
        },
        {
            "label": "Run Swiftlauncher (Release)",
            "type": "shell",
            "dependsOn": "Install swiftlauncher-cli into app",
            "command": "open",
            "args": [
                "build/Build/Products/Release/Swiftlauncher.app"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Install Swiftlauncher to ~/Applications",
            "type": "shell",
            "dependsOn": "Install swiftlauncher-cli into app",
            "command": "cp",
            "args": [
                "-R",
                "-f",
                "build/Build/Products/Release/Swiftlauncher.app",
                "${env:HOME}/Applications/"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Install swiftlauncher-cli into app",
            "type": "shell",
            "dependsOn": ["Build Swiftlauncher (Release)", "Build swiftlauncher-cli"],
            "dependsOrder": "sequence",
            "command": "/bin/sh",
            "args": [
                "-c",
                "cp build/Build/Products/Release/swiftlauncher-cli build/Build/Products/Release/Swiftlauncher.app/Contents/MacOS/swiftlauncher-cli && codesign --force --sign - build/Build/Products/Release/Swiftlauncher.app/Contents/MacOS/swiftlauncher-cli && codesign --force --sign - build/Build/Products/Release/Swiftlauncher.app"
            ],
            "problemMatcher": []
        }
    ]
}
