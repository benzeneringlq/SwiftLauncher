{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Swiftlauncher (Release)",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "Swiftlauncher.xcodeproj",
                "-scheme",
                "Swiftlauncher",
                "-configuration",
                "Release",
                "-derivedDataPath",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Run Swiftlauncher (Release)",
            "type": "shell",
            "dependsOn": "Build Swiftlauncher (Release)",
            "command": "open",
            "args": [
                "build/Build/Products/Release/Swiftlauncher.app"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Install Swiftlauncher to /Applications",
            "type": "shell",
            "dependsOn": "Build Swiftlauncher (Release)",
            "command": "cp",
            "args": [
                "-R",
                "-f",
                "build/Build/Products/Release/Swiftlauncher.app",
                "/Users/liuming/Applications/"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}